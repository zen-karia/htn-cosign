# These switches apply to fixture tooling and Demo Replay generation. Verification Desk
# creates explicit LIVE tasks and never falls back to these fixtures. Settlement is always
# simulated in the main product path for this release, regardless of Solana flags.
MOCK_MODE_OPENAI=true
MOCK_MODE_GPTZERO=true
MOCK_MODE_ELASTICSEARCH=true
MOCK_MODE_SOLANA=true
MOCK_MODE_SENTRY=true
MOCK_MODE_BASETEN=true
MOCK_MODE_BROWSERBASE=true

# Structured independent judges; configurable models, not a claim of model availability on your account.
OPENAI_API_KEY=
OPENAI_CLASSIFIER_MODEL=gpt-4.1-mini
OPENAI_JUDGE_A_MODEL=gpt-4.1-mini
OPENAI_JUDGE_B_MODEL=gpt-4.1
OPENAI_RESOLVER_MODEL=gpt-4.1
# Optional; defaults to OPENAI_RESOLVER_MODEL. Passage entailment is a separate payment veto.
OPENAI_ENTAILMENT_MODEL=gpt-4.1
OPENAI_SELLER_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# GPTZero Bibliography Scan. Do NOT point this at the AI-authorship /predict/text API:
# every submission here is LLM-written by design, so authorship scores flag all of them.
# Adapter posts {document} and reads bibliographic_citations[].citation_exists.status.
# Leave the URL blank to use the default https://api.gptzero.me/v2/bibliography-scan/text
# A scan web-searches each citation and takes ~60s; it needs real, publicly findable
# sources. Against a fictional corpus every citation returns "fake" and nothing is paid.
GPTZERO_API_KEY=
GPTZERO_HALLUCINATION_URL=

# Verification Desk creates one run-scoped evidence index beneath this prefix.
# Local Elasticsearch or a provided Elastic Cloud endpoint. Never expose it to the browser.
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_INDEX=cosign-references

# Optional legacy/devnet harness only. Verification Desk does not call Solana in this release.
SOLANA_RPC_URL=https://api.devnet.solana.com
SOLANA_PROGRAM_ID=Fd9qA4pYkS43ordqGUVyYnaFZqAgRL1qZwa6nCBhC7Xq
# npm run seed generates ignored local keys and npm run setup injects them into .dev.vars.
SOLANA_BUYER_SECRET_KEY=
SOLANA_AUTHORITY_SECRET_KEY=
SOLANA_SELLER_ADDRESSES=

# Sentry backend and browser projects can have separate DSNs. Trace sample rate 1 for the short demo.
SENTRY_DSN=
SENTRY_PUBLIC_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Build-time organization auth token used only to upload source maps; sentry-cli and the Vite plugin read this name.
SENTRY_AUTH_TOKEN=
# Optional read-only user auth token (org:read, event:read) for checking ingested trace evidence; never sent to the browser.
SENTRY_READ_TOKEN=
# Official regional API host if needed, e.g. https://us.sentry.io
SENTRY_API_URL=https://sentry.io

# Optional future integrations. They are not called or claimed by this build.
BASETEN_API_KEY=
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=

# Only needed for an authorized Cloudflare account/dev tunnel. No deploy/publish command runs by default.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Required for API mutations through a dev tunnel; localhost accepts same-origin requests.
API_TOKEN=
# CLI harness target; leave local.
COSIGN_URL=http://127.0.0.1:8787
