{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cosign",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-13",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "assets": { "directory": "dist/web", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "TASKS", "class_name": "TaskObject" }, { "name": "BOARD", "class_name": "BoardObject" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TaskObject", "BoardObject"] }],
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "upload_source_maps": true,
  "kv_namespaces": [{ "binding": "CONFIG", "id": "368384adce2641e292660dca4d44974c" }],
  "vars": { "SENTRY_ENVIRONMENT": "production", "MOCK_MODE_OPENAI": "false", "MOCK_MODE_GPTZERO": "false", "MOCK_MODE_ELASTICSEARCH": "false", "MOCK_MODE_SOLANA": "true", "MOCK_MODE_SENTRY": "false", "MOCK_MODE_BASETEN": "true", "MOCK_MODE_BROWSERBASE": "true", "SOLANA_RPC_URL": "https://api.devnet.solana.com", "ELASTICSEARCH_INDEX": "cosign-references", "OPENAI_JUDGE_A_MODEL": "gpt-4.1-mini", "OPENAI_JUDGE_B_MODEL": "gpt-4.1", "OPENAI_SELLER_MODEL": "gpt-4.1-mini", "OPENAI_RESOLVER_MODEL": "gpt-4.1", "OPENAI_EMBEDDING_MODEL": "text-embedding-3-small" }
}
